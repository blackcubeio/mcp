{
    "name": "blackcube/mcp",
    "description": "MCP server for the Blackcube admin data layer",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "cms",
        "content-management",
        "ai",
        "llm",
        "api-key",
        "headless"
    ],
    "type": "library",
    "license": "BSD-3-Clause",
    "readme": "README.md",
    "homepage": "https://github.com/blackcubeio/mcp",
    "support": {
        "issues": "https://github.com/blackcubeio/mcp/issues",
        "source": "https://github.com/blackcubeio/mcp"
    },
    "authors": [
        {
            "name": "Philippe Gaultier",
            "email": "philippe@blackcube.io"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "mcp/sdk": "^0.9",
        "blackcube/active-record": "^1.0",
        "blackcube/dboard": "^1.0",
        "blackcube/dcore": "^1.0",
        "blackcube/injector": "^1.0",
        "blackcube/bridge-form-model": "^1.0",
        "guzzlehttp/guzzle": "^8.3",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "yiisoft/active-record": "^1.1",
        "yiisoft/aliases": "^3.1",
        "yiisoft/cache": "^3.2",
        "yiisoft/cache-file": "^3.2",
        "yiisoft/csrf": "^2.2",
        "yiisoft/db": "^2.1",
        "yiisoft/db-migration": "^2.2",
        "yiisoft/form-model": "^1.1",
        "yiisoft/hydrator": "^1.6",
        "yiisoft/injector": "^1.2",
        "yiisoft/log": "^2.2",
        "yiisoft/yii-console": "^2.4"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.3",
        "codeception/module-db": "^3.2",
        "httpsoft/http-message": "^1.1",
        "vlucas/phpdotenv": "^5.7",
        "yiisoft/db-mysql": "^2.0",
        "yiisoft/di": "^1.4",
        "yiisoft/event-dispatcher": "^1.1",
        "yiisoft/factory": "^1.3",
        "yiisoft/test-support": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Blackcube\\Mcp\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blackcube\\Mcp\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-devel": "1.x-dev"
        },
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    }
}
